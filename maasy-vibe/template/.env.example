# Backend Supabase (solo si la app usa base de datos, login o storage).
# Believable completa estos valores al deployar como full-stack. Para desarrollo
# local, copia este archivo a .env con los valores de tu proyecto.

# URL del Supabase self-hosted de Believe.
VITE_SUPABASE_URL=https://supabase.believe-global.com

# Anon key compartida (va como header apikey, lo exige el gateway). NO es secreta.
VITE_SUPABASE_ANON_KEY=<lo-completa-believable-al-deployar>

# Key scopeada a tu tenant (para acceso sin login; va como Bearer). Pública por diseño;
# el aislamiento lo hace el RLS del servidor. NUNCA la service role key en el front.
VITE_SUPABASE_TENANT_KEY=<lo-completa-believable-al-deployar>

# Schema de tu tenant (tenant_<slug>). Believable lo completa al deployar.
VITE_SUPABASE_SCHEMA=<lo-completa-believable-al-deployar>

# Prefijo de tus Edge Functions (namespaceadas por tenant). Believable lo completa al deployar.
# Llama tus funciones en: ${VITE_SUPABASE_URL}/functions/v1/${VITE_SUPABASE_FN_PREFIX}<nombre>
VITE_SUPABASE_FN_PREFIX=<lo-completa-believable-al-deployar>
