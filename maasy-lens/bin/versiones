# Cuánto ocupa lo que baja la instalación, en MB redondeados. Se mide sobre los archivos publicados (2026-11-26); sirve
# para decir el tamaño antes de bajar nada. Python y las dependencias de requirements.lock se estiman: uv no dice el peso
# antes de bajarlas.
MB_UV="14"
MB_MODELO="574"
MB_PYTHON_Y_DEPENDENCIAS="205"
MB_WHISPER_CLI="8"
MB_FFMPEG="23"
MB_FFPROBE="23"
MB_DENO="39"
# tamano_mb arm64|x86_64: lo que ocupa la instalación completa en ese Mac. En Intel los binarios salen de Homebrew.
tamano_mb() {
  local t=$((MB_UV + MB_MODELO + MB_PYTHON_Y_DEPENDENCIAS))
  [ "${1:-}" = arm64 ] && t=$((t + MB_WHISPER_CLI + MB_FFMPEG + MB_FFPROBE + MB_DENO))
  echo "$t"
}

# Binarios para Mac con Apple Silicon, sin modificar, cada uno en su carpeta con su LICENSE. De dónde sale cada uno:
