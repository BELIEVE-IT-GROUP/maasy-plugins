#!/usr/bin/env python3
"""Actualiza Maasy Lens en ~/.maasy-lens desde latest.json. bin/lens lo corre en segundo plano al arrancar, así que
no demora el MCP. Cualquier falla deja la versión instalada tal como estaba.

  actualizar          revisa (como mucho cada 6 h) y, si hay versión mayor y ningún análisis corriendo, la instala
  actualizar --seco   solo dice qué haría; no baja nada más que latest.json ni toca la instalación

latest.json: {"version": "0.3.3", "belens": {"url", "sha256"}, "lock": {"url", "sha256"},
               "bin": {"arm64": {"whisper-cli": {"url", "sha256"}, ..., "licencias/deno-LICENSE": {"url", "sha256"},
                                 "deno": {"url": "<zip>", "zip": "deno", "zip_sha256", "sha256"}}}}
Solo se acepta https a files.believe-global.com, sin redirecciones, y cada archivo tiene que coincidir con su sha256.
"bin" lo instala solo un Mac con Apple Silicon, en ~/.maasy-lens/bin: baja lo que no tiene o cambió (si la instalación
venía de Homebrew y no tiene bin/, lo baja todo) y deja igual lo demás. En Intel no se tocan binarios. El sha256 de cada
entrada es el del archivo instalado; para deno, que se publica en el zip oficial, zip_sha256 es el del zip.
Trabajo en curso: belens.py toma .en-curso compartido (flock) mientras analiza; aquí se pide exclusivo y sin esperar.
Si no se puede, no se actualiza. El sistema suelta el flock solo si el proceso muere, así que nunca queda trabado.
"""
import fcntl, hashlib, io, json, os, re, shutil, subprocess, sys, time, urllib.request, zipfile
from pathlib import Path
from urllib.parse import urlsplit

HOST = "files.believe-global.com"
FEED = f"https://{HOST}/apps/maasy-lens/latest.json"
CADA = 6 * 3600  # ponytail: una revisión cada 6 h, marcada en .revisado
UA = "Mozilla/5.0 (Macintosh; Apple silicon) maasy-lens"  # Cloudflare responde 403 sin un User-Agent de navegador
D = Path(os.environ.get("BELENS_HOME") or Path.home() / ".maasy-lens")
PY = os.environ.get("PYTHON_VERSION") or "3.12"
ESPEJO = os.environ.get("MAASY_LENS_ESPEJO_LOCAL", "")  # solo para pruebas: sirve las URLs de HOST desde 127.0.0.1
ARM = os.uname().machine == "arm64"  # igual que bin/instalar: en Intel los binarios salen de Homebrew
NOMBRE_BIN = re.compile(r"(licencias/)?[A-Za-z0-9][A-Za-z0-9._-]*")  # nada de rutas: solo un nombre en bin/ o bin/licencias/


class SinRedireccion(urllib.request.HTTPRedirectHandler):
    def redirect_request(self, *a, **k):  # una redirección podría sacar la descarga del dominio fijado
        return None


RED = urllib.request.build_opener(SinRedireccion)


def fijada(url: str):
    u = urlsplit(url)
    if u.scheme != "https" or u.hostname != HOST or u.port or u.username:
        raise ValueError(f"no es https://{HOST}: {url}")
    return u


def bajar(url: str, timeout: float) -> bytes:
    u = fijada(url)
    if ESPEJO:
        e = urlsplit(ESPEJO)
        if e.scheme != "http" or e.hostname not in ("127.0.0.1", "localhost"):
            raise ValueError("MAASY_LENS_ESPEJO_LOCAL tiene que ser http://127.0.0.1")
        url = ESPEJO.rstrip("/") + u.path
    with RED.open(urllib.request.Request(url, headers={"User-Agent": UA}), timeout=timeout) as r:
        return r.read()


def version(v: str) -> tuple:
    if not re.fullmatch(r"\d+(\.\d+){1,3}", str(v)):
        raise ValueError(f"versión inválida: {v!r}")
    return tuple(map(int, v.split(".")))


def instalada() -> str:
    f = D / "VERSION"  # las instalaciones anteriores a VERSION son las de la versión que trae el plugin
    return f.read_text().strip() if f.exists() else os.environ.get("MAASY_LENS_VERSION_PLUGIN", "0.0")


def candado(nombre: str):
    """El flock exclusivo de D/nombre, o None si otro proceso lo tiene."""
    f = open(D / nombre, "a")
    try:
        fcntl.flock(f, fcntl.LOCK_EX | fcntl.LOCK_NB)
        return f
    except BlockingIOError:
        f.close()
        return None


def sha(p: Path) -> str:
    h = hashlib.sha256()
    with open(p, "rb") as f:
        while b := f.read(1 << 20):
            h.update(b)
    return h.hexdigest()


def probar(venv: Path, bins=None) -> None:
    pruebas = [[venv / "bin/python", "-c", "import yt_dlp, mcp"], [venv / "bin/yt-dlp", "--version"]]
    if bins:  # los binarios nuevos tienen que arrancar en su lugar (firma, arquitectura)
        pruebas += [[bins / n, a] for n, a in (("ffmpeg", "-version"), ("ffprobe", "-version"), ("deno", "--version"),
                                                ("whisper-cli", "--help")) if (bins / n).exists()]
    for c in pruebas:
        subprocess.run([str(x) for x in c], check=True, capture_output=True, timeout=120)


def binarios(feed: dict) -> dict:
    """Las entradas de bin.arm64 ya validadas (nombre, url fijada, sha256); vacío en Intel o si el feed no trae bin."""
    if not ARM:
        return {}
    b = feed.get("bin", {}).get("arm64", {})
    for n, e in b.items():
        if not NOMBRE_BIN.fullmatch(n):
            raise ValueError(f"nombre de binario inválido: {n!r}")
        fijada(e["url"])
        for k in ("sha256", "zip_sha256") if "zip" in e else ("sha256",):
            if not re.fullmatch(r"[0-9a-f]{64}", e[k]):
                raise ValueError(f"{k} inválido para {n}")
        if "zip" in e and not NOMBRE_BIN.fullmatch(e["zip"]):
            raise ValueError(f"miembro de zip inválido para {n}")
    return b


def armar_bin(b: dict, destino: Path) -> bool:
    """Arma en destino el bin/ nuevo: lo que no cambió, enlazado (hardlink) desde el actual; lo nuevo, bajado y verificado.
    Devuelve False si no cambia nada (entonces bin/ queda como está)."""
    actual, cambia = D / "bin", not (D / "bin").is_dir()
    if not cambia:
        shutil.copytree(actual, destino, symlinks=True, copy_function=os.link)
    destino.mkdir(exist_ok=True)
    for n, e in b.items():
        f = destino / n
        if f.is_file() and sha(f) == e["sha256"]:
            continue
        datos = bajar(e["url"], 60)
        if "zip" in e:
            if hashlib.sha256(datos).hexdigest() != e["zip_sha256"]:
                raise ValueError(f"el sha256 del zip de {n} no coincide")
            datos = zipfile.ZipFile(io.BytesIO(datos)).read(e["zip"])
        if hashlib.sha256(datos).hexdigest() != e["sha256"]:
            raise ValueError(f"el sha256 de {n} no coincide")
        f.parent.mkdir(parents=True, exist_ok=True)
        f.unlink(missing_ok=True)  # si era un hardlink, el bin/ actual no se toca
        f.write_bytes(datos)
        f.chmod(0o644 if n.startswith("licencias/") else 0o755)
        cambia = True
    return cambia


def borrar(p: Path) -> None:
    if p.is_dir() and not p.is_symlink():
        shutil.rmtree(p)
    elif p.exists() or p.is_symlink():
        p.unlink()


def cambiar(nuevo: Path, v: str) -> None:
    """Cambia venv, belens.py y bin/ (si viene) con mv; si algo nuevo no anda en su lugar, vuelve todo lo anterior."""
    viejo = D / ".anterior"
    shutil.rmtree(viejo, ignore_errors=True)
    viejo.mkdir()
    nombres = [n for n in ("venv", "belens.py", "bin") if (nuevo / n).exists()]
    movidos = []
    try:
        for n in nombres:
            movidos.append(n)
            if (D / n).exists():
                (D / n).rename(viejo / n)
            (nuevo / n).rename(D / n)
        probar(D / "venv", D / "bin" if "bin" in nombres else None)
    except Exception:
        for n in reversed(movidos):
            if (viejo / n).exists() or not (nuevo / n).exists():  # lo que está en D/n es lo nuevo: se saca
                borrar(D / n)
            if (viejo / n).exists():
                (viejo / n).rename(D / n)
        shutil.rmtree(viejo, ignore_errors=True)
        raise
    (D / "VERSION.part").write_text(v + "\n")
    (D / "VERSION.part").rename(D / "VERSION")
    shutil.rmtree(viejo, ignore_errors=True)


def actualizar(seco: bool = False) -> str:
    marca = D / ".revisado"
    if not seco:
        try:
            if time.time() - float(marca.read_text()) < CADA:
                return "revisado hace poco"
        except (OSError, ValueError):
            pass
        marca.write_text(str(time.time()))
    feed = json.loads(bajar(FEED, 5))
    nueva, actual = feed["version"], instalada()
    if version(nueva) <= version(actual):
        return f"al día ({actual})"
    for k in ("belens", "lock"):
        fijada(feed[k]["url"])
        if not re.fullmatch(r"[0-9a-f]{64}", feed[k]["sha256"]):
            raise ValueError(f"sha256 inválido para {k}")
    bins = binarios(feed)
    if seco:
        return f"hay {nueva} (instalada {actual}); en seco no se instala"
    yo = candado(".actualizando")
    if not yo:
        return "otra actualización está corriendo"
    libre = candado(".en-curso")
    if not libre:
        yo.close()
        marca.unlink(missing_ok=True)  # se reintenta en el próximo arranque, no en 6 h
        return "hay un análisis corriendo; se reintenta en el próximo arranque"
    libre.close()  # no se frena ningún análisis mientras se baja e instala
    nuevo, trabajo = D / f".nuevo-{nueva}", None
    shutil.rmtree(nuevo, ignore_errors=True)
    nuevo.mkdir()
    try:
        for k, nombre in (("belens", "belens.py"), ("lock", "requirements.lock")):
            datos = bajar(feed[k]["url"], 60)
            if hashlib.sha256(datos).hexdigest() != feed[k]["sha256"]:
                raise ValueError(f"el sha256 de {nombre} no coincide")
            (nuevo / nombre).write_bytes(datos)
        if bins and not armar_bin(bins, nuevo / "bin"):
            shutil.rmtree(nuevo / "bin")  # sin cambios: bin/ no se mueve
        env = {**os.environ, "UV_CACHE_DIR": str(D / "uv-cache"), "UV_PYTHON_INSTALL_DIR": str(D / "python")}
        corre = lambda *a, t: subprocess.run([str(x) for x in a], check=True, capture_output=True, env=env, timeout=t)
        corre(D / "uv", "venv", "--quiet", "--relocatable", "--python", PY, nuevo / "venv", t=300)  # relocatable: sobrevive al mv
        corre(D / "uv", "pip", "install", "--quiet", "--python", nuevo / "venv/bin/python", "--require-hashes", "-r",
              nuevo / "requirements.lock", t=900)
        probar(nuevo / "venv")
        trabajo = candado(".en-curso")  # se tiene hasta terminar el cambio: un análisis nuevo espera ese instante
        if not trabajo:
            marca.unlink(missing_ok=True)
            return "empezó un análisis; se reintenta en el próximo arranque"
        cambiar(nuevo, nueva)
        return f"actualizado de {actual} a {nueva}"
    finally:
        shutil.rmtree(nuevo, ignore_errors=True)
        trabajo and trabajo.close()
        yo.close()


if __name__ == "__main__":
    seco = "--seco" in sys.argv
    try:
        print(f"maasy-lens: {actualizar(seco)}", file=sys.stderr)
    except Exception as e:
        print(f"maasy-lens: no se actualizó, sigue la versión instalada ({type(e).__name__}: {e})", file=sys.stderr)
        sys.exit(1 if seco else 0)
