# Variables que leen los scripts del manual. Sin valores: cárgalas desde tu gestor de secretos, nunca en git.

# publish-manual.sh
PUBLISH_R2_BIN=            # herramienta de subida a R2 (por defecto: publish-r2 del PATH)

# purge-cache.mjs (permiso Zone > Cache Purge)
CLOUDFLARE_PURGE_TOKEN=

# benotes.mjs
BENOTES_MAASY_MANUAL_OAUTH=   # lo escribe `benotes.mjs connect`
INFISICAL_PROJECT_ID=
INFISICAL_API_URL=
INFISICAL_TOKEN=              # o bien INFISICAL_CLIENT_ID + INFISICAL_CLIENT_SECRET
INFISICAL_CLIENT_ID=
INFISICAL_CLIENT_SECRET=

# autoupdate.mjs --pr
GH_TOKEN=
